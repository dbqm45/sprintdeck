{
  "name": "sprintdeck",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start -x studio,imgproxy,mailpit,postgres-meta,vector,logflare,supavisor,storage-api,edge-runtime",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "e2e": "playwright test",
    "db:env": "node scripts/db-env.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^2.122.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "overrides": {
    "tinybench": "6.2.3",
    "tinyexec": "1.3.1"
  }
}
