# Local Supabase (`npm run db:start` prints these; `npx supabase status` shows them again).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Bot protection (Cloudflare Turnstile). Leave empty locally: no human check.
# In production set the site key here and the secret in the Supabase project
# (Authentication → Bot and Abuse Protection → Turnstile) — see README.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Sign-in through the suite (DI Identity, Keycloak realm `suite`; dbqm45/pdi docs/plan-pokoj-sprintdeck.md).
# Leave empty: rooms with anonymous sign-in only. The same issuer must work from the browser and from Supabase Auth
# in Docker: locally http://host.docker.internal:8180/realms/suite with "127.0.0.1 host.docker.internal" in /etc/hosts.
NEXT_PUBLIC_SUITE_SIGN_IN=
SUITE_ISSUER=
SUITE_CLIENT_SECRET=
SUITE_ORGANIZATION=
# SPRINTDECK_PUBLIC_URL=http://127.0.0.1:3000
# Supabase Auth reads these two when `npm run db:start` starts it (supabase/config.toml, [auth.external.keycloak]):
# SUPABASE_AUTH_EXTERNAL_KEYCLOAK_URL=<SUITE_ISSUER>
# SUPABASE_AUTH_EXTERNAL_KEYCLOAK_SECRET=<SUITE_CLIENT_SECRET>

# A room from the agenda of DI Decision (pdi): the same secret as PDI_SPRINTDECK_SECRET in pdi.
PDI_SPRINTDECK_SECRET=
