# Local Supabase (`npm run db:start` prints these; `npx supabase status` shows them again).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Bot protection (Cloudflare Turnstile). Leave empty locally: no human check.
# In production set the site key here and the secret in the Supabase project
# (Authentication → Bot and Abuse Protection → Turnstile) — see README.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
